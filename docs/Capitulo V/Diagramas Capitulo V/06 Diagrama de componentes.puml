@startuml
!pragma layout elk
skinparam dpi 300
skinparam backgroundColor white
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam componentStyle uml2
skinparam ArrowColor #333333
skinparam ComponentBorderColor #1F3A5F
skinparam ComponentBackgroundColor #F5F5F5
skinparam NodeBorderColor #7A7A7A
skinparam NodeBackgroundColor #FFFFFF
skinparam RectangleBorderColor #7A7A7A
skinparam RectangleBackgroundColor #FFFFFF
skinparam PackageBorderColor #7A7A7A
skinparam PackageBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #1F3A5F
skinparam DatabaseBackgroundColor #F5F5F5
skinparam InterfaceBorderColor #333333
skinparam InterfaceBackgroundColor #FFFFFF
skinparam CloudBorderColor #7A7A7A
skinparam CloudBackgroundColor #FFFFFF
skinparam NoteBorderColor #7A7A7A
skinparam NoteBackgroundColor #F5F5F5
skinparam NoteFontSize 10
skinparam ArrowFontSize 10

title Diagrama de componentes del sistema enruta

node "Dispositivo del usuario" as DEV {
  node "Navegador web" as BRW {
    component "Aplicación React\n(Vite, TypeScript, React Router,\nTanStack Query)" as SPA
    component "Cargador de Google Maps\n(googleMaps.ts, mapa SVG propio)" as GMJS
  }
}

cloud "DNS Spaceship\n(enruta.world)" as DNS

node "Render: servicio web «rutasia»" as RSVC {
  component "Gunicorn\n(3 procesos)" as GUN
  component "WhiteNoise\n(archivos estáticos\ny build de React)" as WN
  package "Django (rutasia, app logistics)" as DJ {
    component "Presentación\n(vistas /api/*, sesión, roles)" as PRES
    component "Aplicación\n(planning, incidents, assignment,\ndriver, orders, tracking)" as APP
    component "Dominio\n(excepciones, regiones,\nreglas de avisos)" as DOM
    component "Motor de rutas\n(graph, dijkstra, astar,\nmultistop, genetic, traffic)" as ENG
    component "Notificaciones\n(core, customer, staff,\ntransport)" as NOT
    component "Cliente Routes API\n(google.py, solo comandos\ny live-check)" as RCL
  }
}

node "Render: cron «refresh-traffic»" as RCRON {
  component "python manage.py refresh_traffic\n(domingos 12:00 UTC)" as CRON
}

database "PostgreSQL en Neon\n(DATABASE_URL)" as PG

node "Equipo de desarrollo / Google Colab\n(fuera de producción)" as DEVX {
  component "run_thesis_experiment\n(3 escenarios × 10)" as EXPC
  component "OR-Tools\n(línea base)" as ORTC
  component "Cuadernos: estadística (SciPy)\ny refuerzo (TensorFlow)" as NBC
}

cloud "Google Maps Platform" as GMP {
  component "Maps JavaScript API,\nPlaces, Directions\ny Geocoder" as GMAPS
  component "Routes API\n(computeRoutes,\ncomputeRouteMatrix)" as GROUTES
}

cloud "Resend\n(correo transaccional)" as RES

interface "REST" as IREST
interface "API HTTP de Resend" as IMAIL

SPA --> DNS : resuelve enruta.world
DNS ..> GUN : apunta al servicio
SPA --> IREST : API REST /api/*
IREST - GUN
GUN --> WN : /, /assets
GUN --> PRES : WSGI
PRES --> APP
APP --> DOM
APP --> ENG : grafo en memoria
APP --> NOT : tras el commit
APP --> PG : SQL (ORM de Django)
ENG ..> PG : carga única del grafo
NOT --> IMAIL
IMAIL - RES
RCL --> GROUTES : HTTPS
APP ..> RCL : live-check
GMJS --> GMAPS : mapa, direcciones y trazo
SPA --> GMJS
CRON --> RCL : calibrar tráfico
CRON --> PG
EXPC --> ENG : mismo motor
EXPC --> ORTC : compara
EXPC ..> PG : lee el grafo
NBC ..> EXPC : CSV y grafo.json
note bottom of RCL
  La planificación no llama a la Routes API:
  usa los datos ya guardados en PostgreSQL.
end note
@enduml
