@startuml
!pragma layout smetana
!include ../estilo.iuml
left to right direction
title Diagrama de casos de uso: acceso y administración

actor "Administrador\ndel sistema" as ADM
actor "Coordinador\nde rutas" as COO
actor "Mensajero" as MEN

rectangle "Sistema enruta" {
  package "Acceso" {
    usecase "Iniciar sesión" as U_LOGIN
    usecase "Cambiar contraseña\ntemporal" as U_PASS
  }
  package "Administración" {
    usecase "Gestionar usuarios" as U_USR
    usecase "Gestionar bodegas" as U_BOD
    usecase "Gestionar conductores" as U_PIL
    usecase "Gestionar vehículos" as U_CAM
    usecase "Ajustar parámetros del\nalgoritmo genético" as U_GA
  }
  usecase "Enviar avisos por correo\n(detallado en 01e)" as U_MAIL EXTERNO
}

ADM -|> COO
COO --> U_LOGIN
MEN --> U_LOGIN
ADM --> U_USR
ADM --> U_BOD
ADM --> U_PIL
ADM --> U_CAM
ADM --> U_GA

U_PASS ..> U_LOGIN : <<extender>>
U_USR ..> U_MAIL : <<incluir>>

note bottom of U_GA
  Se ajustan en el panel de
  administración de Django
  (fila única de parámetros).
end note

legend bottom
  El administrador hereda todo lo del coordinador
  (planificación en 01b, monitoreo en 01c).
  La contraseña temporal llega por correo y
  vence en 72 horas.
endlegend
@enduml
