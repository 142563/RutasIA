@startuml
!pragma layout smetana
left to right direction
skinparam dpi 200
skinparam backgroundColor white
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam ArrowColor #333333
skinparam ActorBorderColor #333333
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1F3A5F
skinparam UsecaseBackgroundColor #F5F5F5
skinparam RectangleBorderColor #333333
skinparam RectangleBackgroundColor #FFFFFF
skinparam PackageBorderColor #7A7A7A
skinparam PackageBackgroundColor #FFFFFF
skinparam NoteBorderColor #7A7A7A
skinparam NoteBackgroundColor #F5F5F5
skinparam ArrowFontSize 10
skinparam LegendBackgroundColor #F5F5F5
skinparam LegendBorderColor #7A7A7A
skinparam LegendFontSize 10

title Diagrama de casos de uso del sistema enruta

actor "Administrador\ndel sistema" as ADM
actor "Coordinador\nde rutas" as COO
actor "Mensajero" as MEN
actor "Cliente final" as CLI
rectangle "Sistemas externos" as EXT {
  actor "API de Google Maps" as GGL
  actor "Servicio de correo\nResend" as RES
}

rectangle "Sistema enruta" {
  package "Acceso" {
    usecase "Iniciar sesión" as U_LOGIN
    usecase "Cambiar contraseña\ntemporal" as U_PASS
  }
  package "Administración" {
    usecase "Gestionar usuarios" as U_USR
    usecase "Gestionar bodegas" as U_BOD
    usecase "Gestionar conductores\n(pilotos)" as U_PIL
    usecase "Gestionar vehículos\n(camiones)" as U_CAM
    usecase "Ajustar parámetros del\nalgoritmo genético" as U_GA
  }
  package "Planificación" {
    usecase "Registrar pedido" as U_PED
    usecase "Planificar ruta\noptimizada" as U_PLAN
    usecase "Ordenar paradas con el\nalgoritmo genético" as U_CALC
    usecase "Calcular matriz y tramos\n(Dijkstra y A*)" as U_TRAMOS
    usecase "Asignar conductor\ny vehículo" as U_ASIG
    usecase "Consultar análisis\nDijkstra contra A*" as U_ANA
  }
  package "Monitoreo y recálculo" {
    usecase "Monitorear rutas\nen vivo" as U_MON
    usecase "Verificar tráfico\nen vivo" as U_LIVE
    usecase "Reportar incidente" as U_INC
    usecase "Recalcular rutas\nafectadas (A*)" as U_REC
    usecase "Aprobar recálculo" as U_APR
  }
  package "Operación del mensajero" {
    usecase "Ver ruta del día" as U_DIA
    usecase "Iniciar ruta" as U_INI
    usecase "Navegar dentro\nde la app" as U_NAV
    usecase "Marcar entrega\no no entrega" as U_ENT
    usecase "Compartir ubicación GPS" as U_GPS
  }
  package "Seguimiento y avisos" {
    usecase "Seguir pedido\n(enlace público)" as U_SEG
    usecase "Enviar avisos\npor correo" as U_MAIL
  }
  usecase "Ubicar dirección\nen el mapa" as U_GEO
  usecase "Mostrar ruta\nen el mapa" as U_MAPA
}

ADM -|> COO

ADM --> U_USR
ADM --> U_BOD
ADM --> U_PIL
ADM --> U_CAM
ADM --> U_GA

COO --> U_LOGIN
MEN --> U_LOGIN
COO --> U_PED
COO --> U_PLAN
COO --> U_MON
COO --> U_ANA
COO --> U_INC
COO --> U_APR

MEN --> U_DIA
MEN --> U_INI
MEN --> U_NAV
MEN --> U_ENT
MEN --> U_GPS
MEN --> U_INC
MEN --> U_APR

CLI --> U_SEG
CLI --> U_MAIL

U_PASS .u.> U_LOGIN : <<extender>>
U_PED ..> U_GEO : <<incluir>>
U_PED ..> U_MAIL : <<incluir>>
U_PLAN ..> U_CALC : <<incluir>>
U_CALC ..> U_TRAMOS : <<incluir>>
U_PLAN ..> U_MAPA : <<incluir>>
U_PLAN ..> U_MAIL : <<incluir>>
U_ASIG .u.> U_PLAN : <<extender>>
U_MON ..> U_MAPA : <<incluir>>
U_LIVE .u.> U_MON : <<extender>>
U_INC ..> U_REC : <<incluir>>
U_INC ..> U_MAIL : <<incluir>>
U_APR .u.> U_REC : <<extender>>
U_NAV ..> U_MAPA : <<incluir>>
U_ENT ..> U_MAIL : <<incluir>>

U_GEO --> GGL
U_MAPA --> GGL
U_LIVE --> GGL
U_TRAMOS --> GGL
U_MAIL --> RES

legend bottom
  Notas.
  - El administrador puede hacer todo lo del coordinador (el rol admin está incluido en los permisos de despacho).
  - Aprobar recálculo: lo decide el conductor de la ruta o el despacho (coordinador o administrador).
  - Enviar avisos por correo: el cliente final lo recibe en Order.recipient_email; el personal, según su rol.
endlegend
@enduml
