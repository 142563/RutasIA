' Estilo común de las figuras del Capítulo V.
' 300 dpi: un PNG de 1 890 px de ancho mide 16 cm impreso. Ninguna letra baja de 10 pt.
skinparam dpi 300
skinparam backgroundColor white
skinparam shadowing false
skinparam monochrome false
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam TitleFontSize 12
skinparam TitleFontStyle bold
skinparam ArrowFontSize 10
skinparam NoteFontSize 10
skinparam LegendFontSize 10
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam NoteBorderColor #7A7A7A
skinparam NoteBackgroundColor #F5F5F5
skinparam ActorBorderColor #333333
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1F3A5F
skinparam UsecaseBackgroundColor #F5F5F5
skinparam RectangleBorderColor #333333
skinparam RectangleBackgroundColor #FFFFFF
skinparam PackageBorderColor #7A7A7A
skinparam PackageBackgroundColor #FFFFFF
skinparam ClassBorderColor #1F3A5F
skinparam ClassBackgroundColor #F5F5F5
skinparam ClassHeaderBackgroundColor #DDE6F0
skinparam classAttributeIconSize 0
skinparam ObjectBorderColor #1F3A5F
skinparam ObjectBackgroundColor #F5F5F5
skinparam EntityBorderColor #1F3A5F
skinparam EntityBackgroundColor #F5F5F5
skinparam ComponentBorderColor #1F3A5F
skinparam ComponentBackgroundColor #F5F5F5
skinparam componentStyle uml2
skinparam NodeBorderColor #7A7A7A
skinparam NodeBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #1F3A5F
skinparam DatabaseBackgroundColor #F5F5F5
skinparam CloudBorderColor #7A7A7A
skinparam CloudBackgroundColor #FFFFFF
skinparam InterfaceBorderColor #333333
skinparam InterfaceBackgroundColor #FFFFFF
skinparam ActivityBorderColor #1F3A5F
skinparam ActivityBackgroundColor #F5F5F5
skinparam ActivityDiamondBorderColor #1F3A5F
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityStartColor #333333
skinparam ActivityEndColor #333333
skinparam SwimlaneBorderColor #7A7A7A
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneTitleFontSize 10
skinparam SequenceLifeLineBorderColor #7A7A7A
skinparam ParticipantBorderColor #1F3A5F
skinparam ParticipantBackgroundColor #F5F5F5
skinparam SequenceGroupBorderColor #7A7A7A
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceGroupHeaderFontSize 10
skinparam SequenceReferenceBackgroundColor #EEEEEE
skinparam SequenceReferenceBorderColor #888888
skinparam SequenceDividerFontSize 10
skinparam ParticipantPadding 4
skinparam BoxPadding 4
skinparam LegendBackgroundColor #F5F5F5
skinparam LegendBorderColor #7A7A7A
' Elemento que se detalla en otra parte: caja gris punteada
!define EXTERNO #EEEEEE;line.dashed;line:888888;text:555555
