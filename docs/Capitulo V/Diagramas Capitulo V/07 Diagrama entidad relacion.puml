@startuml
!pragma layout elk
skinparam dpi 300
skinparam backgroundColor white
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam ArrowColor #333333
skinparam ClassBorderColor #1F3A5F
skinparam ClassBackgroundColor #F5F5F5
skinparam ClassHeaderBackgroundColor #DDE6F0
skinparam NoteBorderColor #7A7A7A
skinparam NoteBackgroundColor #F5F5F5
skinparam NoteFontSize 10
skinparam ArrowFontSize 10
hide circle

title Diagrama entidad-relación de la base de datos de enruta

entity "auth_user" as user {
  * id : integer <<PK>>
  --
  username : varchar(150) <<UK>>
  email : varchar(254)
  is_active : boolean
}
entity "logistics_userprofile" as profile {
  * id : integer <<PK>>
  --
  * user_id : integer <<FK, UK>>
  role : varchar(20)
  must_change_password : boolean
  temp_password_expires_at : timestamp
}
entity "logistics_driver" as driver {
  * id : integer <<PK>>
  --
  user_id : integer <<FK, UK>>
  name : varchar(120)
  license_number : varchar(30) <<UK>>
  is_active : boolean
}
entity "logistics_vehicle" as vehicle {
  * id : integer <<PK>>
  --
  driver_id : integer <<FK>>
  plate : varchar(16) <<UK>>
  model : varchar(100)
  capacity_kg : numeric(8,2)
  is_active : boolean
}
entity "logistics_depot" as depot {
  * id : integer <<PK>>
  --
  node_id : integer <<FK>>
  name : varchar(120) <<UK>>
  latitude : double
  longitude : double
  is_active : boolean
}
entity "logistics_order" as order {
  * id : integer <<PK>>
  --
  node_id : integer <<FK>>
  code : varchar(24) <<UK>>
  tracking_token : varchar(32) <<UK>>
  recipient : varchar(120)
  recipient_email : varchar(254)
  latitude : double
  longitude : double
  weight_kg : numeric(8,2)
  priority : varchar(10)
  status : varchar(16)
}
entity "logistics_route" as route {
  * id : integer <<PK>>
  --
  depot_id : integer <<FK>>
  driver_id : integer <<FK>>
  vehicle_id : integer <<FK>>
  created_by_id : integer <<FK>>
  code : varchar(24) <<UK>>
  departure_at : timestamp
  criterion : varchar(10)
  optimizer : varchar(16)
  driving_minutes : double
  total_km : double
  finish_at : timestamp
  legs : jsonb
  status : varchar(16)
}
entity "logistics_optimizersettings" as optset {
  * id : integer <<PK>> (= 1)
  --
  population : integer
  generations : integer
  tournament : integer
  crossover_rate : double
  mutation_rate : double
  elitism : integer
  stall_generations : integer
  seed : integer
  local_search : boolean
  local_search_rate : double
  updated_at : timestamp
}
entity "logistics_routestop" as stop {
  * id : integer <<PK>>
  --
  * route_id : integer <<FK>>
  * order_id : integer <<FK>>
  sequence : integer
  eta : timestamp
  status : varchar(10)
  delivered_at : timestamp
}
entity "logistics_vehicleposition" as position {
  * id : integer <<PK>>
  --
  * route_id : integer <<FK>>
  * driver_id : integer <<FK>>
  lat : double
  lng : double
  recorded_at : timestamp
}
entity "logistics_node" as node {
  * id : integer <<PK>>
  --
  code : varchar(40) <<UK>>
  name : varchar(120)
  kind : varchar(10)
  latitude : double
  longitude : double
}
entity "logistics_edge" as edge {
  * id : integer <<PK>>
  --
  * origin_id : integer <<FK>>
  * destination_id : integer <<FK>>
  distance_km : double
  duration_free_min : double
  road : varchar(20)
  road_class : varchar(10)
  source : varchar(10)
}
entity "logistics_trafficprofile" as profile_t {
  * id : integer <<PK>>
  --
  * edge_id : integer <<FK>>
  band : varchar(12)
  day_type : varchar(8)
  multiplier : double
}
entity "logistics_routesample" as sample {
  * id : integer <<PK>>
  --
  * origin_id : integer <<FK>>
  * destination_id : integer <<FK>>
  routing_preference : varchar(30)
  duration_s : double
  static_duration_s : double
  fetched_at : timestamp
}
entity "logistics_incident" as incident {
  * id : integer <<PK>>
  --
  route_id : integer <<FK>>
  reported_by_id : integer <<FK>>
  kind : varchar(12)
  blocked : boolean
  multiplier : double
  starts_at : timestamp
  ends_at : timestamp
}
entity "logistics_incident_edges" as incident_edges {
  * id : integer <<PK>>
  --
  * incident_id : integer <<FK>>
  * edge_id : integer <<FK>>
}
entity "logistics_rerouteproposal" as reroute {
  * id : integer <<PK>>
  --
  * route_id : integer <<FK>>
  incident_id : integer <<FK>>
  decided_by_id : integer <<FK>>
  current_minutes : double
  proposed_minutes : double
  proposed_legs : jsonb
  status : varchar(10)
}
entity "logistics_notificationlog" as notif {
  * id : integer <<PK>>
  --
  user_id : integer <<FK>>
  order_id : integer <<FK>>
  route_id : integer <<FK>>
  event : varchar(32)
  audience : varchar(10)
  recipient : varchar(254)
  status : varchar(10)
  dedupe_key : varchar(160)
}
entity "logistics_loginattempt" as login {
  * id : integer <<PK>>
  --
  key : varchar(80) <<UK>>
  failures : jsonb
  blocked_until : timestamp
}

user ||--|| profile
user |o--o| driver
driver |o--o{ vehicle
node |o--o{ depot
node |o--o{ order
depot ||--o{ route
driver |o--o{ route
vehicle |o--o{ route
user |o--o{ route
route ||--|{ stop
order ||--o{ stop
route ||--o{ position
driver ||--o{ position
node ||--o{ edge : origen
node ||--o{ edge : destino
edge ||--o{ profile_t
node ||--o{ sample : origen
node ||--o{ sample : destino
incident ||--|{ incident_edges
edge ||--o{ incident_edges
route |o--o{ incident
user |o--o{ incident
route ||--o{ reroute
incident |o--o{ reroute
user |o--o{ reroute
user |o--o{ notif
order |o--o{ notif
route |o--o{ notif

note bottom of login
  logistics_loginattempt no tiene relaciones: guarda por llave (cuenta o IP) los intentos fallidos.
  logistics_optimizersettings tampoco: es una fila única con los parámetros del algoritmo genético.
  Excluidas por estar heredadas y sin uso: logistics_department, logistics_routeconnection,
  logistics_trip, logistics_triporder, logistics_tripevent y logistics_fuelprice
  (las columnas heredadas de origen, destino y departamento actual no se muestran).
end note
@enduml
