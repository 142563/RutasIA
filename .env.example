# Copia este archivo como .env y llena los valores. Nunca subas .env al repositorio.

# Django
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Base de datos (Neon/PostgreSQL). Si la dejas vacía se usa SQLite local (db.sqlite3).
DATABASE_URL=

# Google Maps — key del NAVEGADOR (Maps JavaScript, Places, Directions). Restringirla por HTTP referrer.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Google Routes API — key del SERVIDOR (construir el grafo y calibrar el tráfico). Nueva en el plan.
GOOGLE_ROUTES_API_KEY=

# Legado (OpenRouteService), ya no se usa en el plan nuevo
ORS_API_KEY=

# Contraseña de los usuarios de demo (python manage.py seed_demo_users). Nunca uses una fija en producción.
DEMO_PASSWORD=
